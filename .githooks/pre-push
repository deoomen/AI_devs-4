#!/usr/bin/env bash
#
# Git pre-push hook: run pylint before pushing.
#

set -euo pipefail

# Resolve project root (where pyproject.toml lives)
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Use the project venv's pylint
PYLINT="${REPO_ROOT}/.venv/bin/pylint"

if [ ! -x "$PYLINT" ]; then
    echo "pre-push: pylint not found at ${PYLINT} — skipping lint check."
    echo "         Install with: pip install 'pylint>=4.0'"
    exit 0
fi

echo "pre-push: running pylint..."

# Temporarily disable exit-on-error so we can inspect the exit code ourselves.
set +e
"$PYLINT" app/ services/ missions/ config.py main.py
PYLINT_EXIT=$?
set -e

# pylint exit code is a bitmask:
#   1 = fatal (F)   2 = error (E)   4 = warning   8 = refactor   16 = convention
# Fail only on fatal (1) and error (2).
if (( PYLINT_EXIT & 3 )); then
    echo ""
    echo "pre-push: pylint found E/F errors. Fix them before pushing."
    echo "         Run: .venv/bin/pylint app/ services/ missions/ config.py main.py"
    exit 1
fi

echo "pre-push: pylint passed."
exit 0
