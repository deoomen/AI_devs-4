DEBUG=false
LOG_LEVEL=INFO

# Auth
API_KEY=change-me

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# LLM Provider
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_DEFAULT_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_DEFAULT_VISION_MODEL=google/gemini-3-flash-preview
PROVIDER_MAX_RETRIES=3

# AIDevs Headquarters
AIDEVS4_HEADQUARTERS_API_KEY=
AIDEVS4_HEADQUARTERS_SYSTEM_URL=

# Agent defaults
AGENT_DEFAULT_NAME=alice
AGENT_MAX_TURNS=10
AGENT_RATE_LIMIT_RPM=30
AGENT_WORKSPACE_DIR=workspace

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
